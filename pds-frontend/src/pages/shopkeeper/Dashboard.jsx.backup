import { useEffect, useState } from "react";
import { useNavigate } from "react-router-dom";
import {
  Activity,
  ArrowRight,
  BarChart3,
  Box,
  Clock,
  MapPin,
  Package,
  QrCode,
  RefreshCw,
  Store,
  TrendingUp,
  Wifi,
  WifiOff,
  Zap,
} from "lucide-react";
import api from "../../api/axios";
import Card from "../../components/ui/Card";
import Skeleton from "../../components/ui/Skeleton";
import Button from "../../components/ui/Button";
import Badge from "../../components/ui/Badge";

// Helper to get time-based greeting
const getGreeting = () => {
  const hour = new Date().getHours();
  if (hour < 12) return "Good morning";
  if (hour < 17) return "Good afternoon";
  return "Good evening";
};

// Helper to format relative time
const getRelativeTime = (date) => {
  const seconds = Math.floor((new Date() - new Date(date)) / 1000);
  if (seconds < 60) return `${seconds}s ago`;
  const minutes = Math.floor(seconds / 60);
  if (minutes < 60) return `${minutes}m ago`;
  const hours = Math.floor(minutes / 60);
  if (hours < 24) return `${hours}h ago`;
  return `${Math.floor(hours / 24)}d ago`;
};

const Dashboard = () => {
  const navigate = useNavigate();
  const [loading, setLoading] = useState(true);
  const [data, setData] = useState(null);
  const [deviceStatus, setDeviceStatus] = useState(null);
  const [error, setError] = useState("");
  const [reloadKey, setReloadKey] = useState(0);
  const [currentTime, setCurrentTime] = useState(new Date());

  useEffect(() => {
    let isMounted = true;
    const loadDashboard = async () => {
      setLoading(true);
      setError("");

      const [profileResult, deviceResult] = await Promise.allSettled([
        api.get("/api/shopkeeper/me"),
        api.get("/api/dispense/device-status"),
      ]);

      if (!isMounted) return;

      if (profileResult.status === "fulfilled") {
        setData(profileResult.value.data);
      } else {
        setData(null);
        setError(
          profileResult.reason?.response?.data?.error ||
          "Could not load shop details.",
        );
      }

      setDeviceStatus(
        deviceResult.status === "fulfilled" ? deviceResult.value.data : null,
      );
      setLoading(false);
    };

    loadDashboard();
    return () => {
      isMounted = false;
    };
  }, [reloadKey]);

  const deviceLabel =
    deviceStatus === null
      ? "Status unavailable"
      : !deviceStatus.active
        ? "No active device"
        : deviceStatus.connectivity === "online"
          ? "Connected"
          : "Offline";
  const deviceBadge =
    deviceStatus?.active && deviceStatus.connectivity === "online"
      ? "success"
      : deviceStatus?.active
        ? "warning"
        : "neutral";

  return (
    <div className="mx-auto max-w-5xl space-y-6">
      <div className="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <p className="text-sm font-semibold uppercase tracking-wider text-brand-700">
            Shop operations
          </p>
          <h1 className="mt-1 text-2xl font-semibold text-text-primary">
            {data?.shop?.name || "Shopkeeper dashboard"}
          </h1>
          {data?.shop?.area && (
            <p className="mt-1 flex items-center gap-1.5 text-sm text-text-secondary">
              <MapPin size={15} />
              {data.shop.area}
            </p>
          )}
        </div>
        {data && (
          <Button
            variant="primary"
            className="h-11 px-5"
            onClick={() => navigate("/shopkeeper/scan")}
          >
            <QrCode size={17} />
            Dispense Ration
            <ArrowRight size={16} />
          </Button>
        )}
      </div>

      {loading ? (
        <div className="space-y-4" aria-label="Loading shop operations">
          <Skeleton.Card />
          <div className="grid gap-4 sm:grid-cols-2">
            <Skeleton.Card />
            <Skeleton.Card />
          </div>
        </div>
      ) : error ? (
        <Card>
          <div className="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <h2 className="font-semibold text-text-primary">
                Shop details unavailable
              </h2>
              <p role="alert" className="mt-1 text-sm text-danger-text">
                {error}
              </p>
            </div>
            <Button
              variant="secondary"
              onClick={() => setReloadKey((key) => key + 1)}
            >
              <RefreshCw size={15} />
              Retry
            </Button>
          </div>
        </Card>
      ) : (
        <div className="space-y-5">
          <div className="grid gap-4 sm:grid-cols-2">
            <Card bodyClassName="flex min-h-36 items-start justify-between">
              <div>
                <p className="text-sm text-text-secondary">
                  Transactions today
                </p>
                <p className="mt-2 text-3xl font-semibold tabular-nums text-text-primary">
                  {data?.today_transactions ?? "—"}
                </p>
                <p className="mt-1 text-xs text-text-secondary">
                  Completed records for this shop
                </p>
              </div>
              <span className="rounded-md bg-brand-50 p-2.5 text-brand-700">
                <Box size={20} />
              </span>
            </Card>

            <Card bodyClassName="flex min-h-36 flex-col justify-between gap-4">
              <div className="flex items-start justify-between gap-3">
                <div>
                  <p className="text-sm text-text-secondary">Weighing device</p>
                  <p className="mt-2 text-lg font-semibold text-text-primary">
                    {deviceStatus?.device_name || "IoT scale"}
                  </p>
                </div>
                {deviceStatus?.connectivity === "online" ? (
                  <Wifi size={20} className="text-success-text" />
                ) : (
                  <WifiOff size={20} className="text-text-secondary" />
                )}
              </div>
              <div className="flex items-center justify-between gap-2">
                <Badge status={deviceBadge} dot>
                  {deviceLabel}
                </Badge>
                {deviceStatus?.last_seen_at && (
                  <span className="text-xs text-text-secondary">
                    Last seen{" "}
                    {new Date(deviceStatus.last_seen_at).toLocaleString()}
                  </span>
                )}
              </div>
            </Card>
          </div>

          <Card bodyClassName="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div className="flex items-start gap-3">
              <span className="rounded-md border border-border bg-surface-muted p-2.5 text-text-secondary">
                <Store size={19} />
              </span>
              <div>
                <p className="font-semibold text-text-primary">Assigned shop</p>
                <p className="mt-1 text-sm text-text-secondary">
                  {data?.shop?.code
                    ? `Code ${data.shop.code}`
                    : "Shop code unavailable"}
                  {data?.shopkeeper?.name ? ` · ${data.shopkeeper.name}` : ""}
                </p>
              </div>
            </div>
            <div className="text-sm text-text-secondary sm:text-right">
              <p>{data?.shopkeeper?.email || "Email unavailable"}</p>
              <p>{data?.shopkeeper?.mobile || "Mobile unavailable"}</p>
            </div>
          </Card>
        </div>
      )}
    </div>
  );
};

export default Dashboard;
